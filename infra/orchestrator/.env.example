# Copy to infra/orchestrator/.env (git-ignored). provision.sh appends MM_BOT_TOKEN.
MM_URL=http://127.0.0.1:8065
MM_TEAM=amolla
HYLE_USERNAME=hyle
BOT_USERNAME=orchestrator
# MM_BOT_TOKEN=   (written by infra/chat/provision.sh)

# LLM: DeepSeek via the OpenAI-compatible API (on the VPS run `setup-bot-key`).
# Model id deepseek-flash = DeepSeek-V4.1-Flash (api-docs.deepseek.com, 2026-11-15). Do not use legacy deepseek-v4-flash.
# Old names OPENAI_API_KEY / OPENAI_BASE_URL / ORCH_MODEL are still read as fallbacks.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
ORCH_MAX_TOKENS=2500

# Read-only GitHub. Public repo works without a token (60 req/h); a fine-grained
# token with read-only "Contents/Issues/Pull requests/Checks" on 2026NASA avoids limits.
GITHUB_REPO=cloudsnuchoi/2026NASA
GITHUB_TOKEN=

REPO_DIR=/srv/hackathon/projects/2026NASA
HISTORY_TURNS=16
DOC_BUDGET_CHARS=60000
TZ=Asia/Seoul
